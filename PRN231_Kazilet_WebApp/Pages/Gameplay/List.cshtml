@page
@model PRN231_Kazilet_WebApp.Pages.Gameplay.ListModel
@{
}
<div class="flex flex-col items-center">
    <div style="width: 750px">
        <div class="mt-6 flex items-center">
            <div class="mr-2">
                <svg class="h-8 w-8 text-black" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">  <path stroke="none" d="M0 0h24v24H0z" />  <rect x="2" y="6" width="20" height="12" rx="2" />  <path d="M6 12h4m-2 -2v4" />  <line x1="15" y1="11" x2="15" y2="11.01" />  <line x1="18" y1="13" x2="18" y2="13.01" /></svg>
            </div>
            <div class="text-2xl font-bold">
                Gameplay History
            </div>


        </div>
        <div id="listgame" class="mt-6 flex flex-col w-full">
            
        </div>
    </div>
</div>

<script>
    getListGameplay();
    function formatDate(date) {
        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0'); // Tháng trong JS bắt đầu từ 0
        const year = date.getFullYear();

        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');

        return `${day}/${month}/${year}, ${hours}:${minutes}`;
    }

    function goTo(id) {
        console.log(id);
        window.location.href = "https://localhost:7081/Gameplay/Report?id=" + id;
    }

    async function getListGameplay() {
        const apiUrl = "http://localhost:7024/api/Gameplay/get-all";
        try {
            const response = await fetch(apiUrl, {
                method: 'GET'
            })

            if (response.ok) {
                const data = await response.json();
                console.log(data);
                document.getElementById("listgame").innerHTML = "";
                for (var i = 0; i < data.length; i++) {
                    var html = `
                                    <div id="${data[i].id}" onclick="goTo(${data[i].id})" class="flex cursor-pointer mb-6 justify-between items-center shadow rounded-lg px-4 py-8">
                            <div class="flex items-center">
                                <div class="mr-4">
                                    <img src="/images/host.png" class="w-10 h-10" />
                                </div>
                                <div class="flex flex-col">
                                    <div class="text-xl font-bold mb-2">
                                        ${data[i].courseName}
                                    </div>
                                    <div>
                                            Created at ${formatDate(new Date(data[i].createdAt))}
                                    </div>
                                </div>
                            </div>
                            <div>
                                <span class="text-xl font-bold">${data[i].noPlayers}</span> players
                            </div>
                        </div>`;
                    document.getElementById("listgame").innerHTML += html;
                }
            }
        } catch (error) {
            console.log(error);
        }
    }
</script>